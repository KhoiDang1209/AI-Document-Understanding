# Copy to .env and adjust. All keys use the DOCINTEL_ prefix.
DOCINTEL_ENVIRONMENT=local
DOCINTEL_LOG_LEVEL=INFO
DOCINTEL_HOST=0.0.0.0
DOCINTEL_PORT=8000

# Backing services (defaults target the docker-compose network)
DOCINTEL_MLFLOW_TRACKING_URI=http://mlflow:5000
DOCINTEL_MINIO_ENDPOINT=minio:9000
DOCINTEL_MINIO_ACCESS_KEY=minioadmin
DOCINTEL_MINIO_SECRET_KEY=minioadmin

# Filesystem
DOCINTEL_DATA_DIR=data

# OCR pipeline (Phase 1)
DOCINTEL_OCR_ENGINE=doctr
DOCINTEL_PREPROCESS_ENABLED=false
DOCINTEL_PREPROCESS_MAX_DIM=2000
DOCINTEL_MAX_UPLOAD_MB=10

# KIE (Phase 2)
DOCINTEL_KIE_MODEL_NAME=microsoft/layoutlmv3-base
DOCINTEL_KIE_REGISTERED_MODEL_NAME=cord-layoutlmv3

# RAG / Vector retrieval (C2)
DOCINTEL_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DOCINTEL_RAG_EMBEDDING_LOCAL_PATH=
DOCINTEL_QDRANT_URL=http://localhost:6333
DOCINTEL_QDRANT_COLLECTION=contract_chunks
DOCINTEL_RAG_TOP_K=5
DOCINTEL_RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
DOCINTEL_RAG_RERANK_CANDIDATES=30
DOCINTEL_LLM_BASE_URL=
DOCINTEL_LLM_API_KEY=
DOCINTEL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Contract extractor serving (C1)
DOCINTEL_CONTRACT_ONNX_LOCAL_PATH=
DOCINTEL_CONTRACT_MAX_UPLOAD_MB=25

# GraphRAG / Neo4j (C3) — password must match the neo4j container's NEO4J_AUTH
DOCINTEL_NEO4J_URI=bolt://localhost:7687
DOCINTEL_NEO4J_USER=neo4j
DOCINTEL_NEO4J_PASSWORD=docintelpass
DOCINTEL_NEO4J_DATABASE=neo4j
DOCINTEL_GRAPH_ENABLED=true

# Agent / LangGraph + Langfuse (C4)
DOCINTEL_AGENT_ENABLED=true
DOCINTEL_AGENT_MAX_RETRIES=1
DOCINTEL_LANGFUSE_HOST=http://localhost:3000
DOCINTEL_LANGFUSE_PUBLIC_KEY=
DOCINTEL_LANGFUSE_SECRET_KEY=
